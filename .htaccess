DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Works at domain root (zakopeyki.kz) and in a subfolder (/zakapeiku/).
    # Do not hardcode RewriteBase — Apache uses the .htaccess directory.

    # Block direct access to sensitive paths
    RewriteRule ^config(/|$) - [F]
    RewriteRule ^app(/|$) - [F]
    RewriteRule ^database(/|$) - [F]
    RewriteRule ^lang(/|$) - [F]
    RewriteRule ^storage(/|$) - [F]
    # Служебные каталоги: CLI-скрипты, тесты, кроны, отчёты QA и внутренняя документация
    RewriteRule ^tools(/|$) - [F]
    RewriteRule ^tests(/|$) - [F]
    RewriteRule ^scripts(/|$) - [F]
    RewriteRule ^qa(/|$) - [F]
    RewriteRule ^docs(/|$) - [F]
    RewriteRule ^qa\.zip$ - [F]
    # CLI-скрипты, логи, временные файлы, распакованные архивы, git и прочие скрытые файлы
    RewriteRule ^bin(/|$) - [F]
    # Исходники мобильного приложения (Flutter)
    RewriteRule ^mobile(/|$) - [F]
    RewriteRule ^logs(/|$) - [F]
    RewriteRule ^tmp(/|$) - [F]
    RewriteRule ^_vas[0-9]+_extract(/|$) - [F]
    RewriteRule ^\.(?!well-known/) - [F]
    # Служебные файлы в корне: отчёты, дампы, спецификации, тестовые артефакты
    RewriteCond %{REQUEST_URI} !/(robots\.txt|sitemap[^/]*\.xml)$
    RewriteRule ^[^/]+\.(md|txt|mp3|zip|sql|xml|log|sh)$ - [F]
    RewriteRule ^openapi[^/]*\.json$ - [F]
    RewriteRule ^tmp_[^/]*\.html$ - [F]

    RewriteRule ^\.env$ - [F]
    RewriteRule ^composer\.json$ - [F]
    RewriteRule ^composer\.lock$ - [F]

    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
