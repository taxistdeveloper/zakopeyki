{
    "name": "zakopeyki/ai-platform",
    "description": "Zakopeyki AI Platform - PHP 8.1 + MySQL + MVC",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/database": "^10.0",
        "php-ai/php-ml": "^0.10.0",
        "psr/log": "^3.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-redis": "Faster native Redis client (predis is used as the portable default)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit tests/"
    }
}
