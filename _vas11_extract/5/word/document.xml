oft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex wp14"><w:body><w:p w14:paraId="3366A058" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t xml:space="preserve">Задача: VAS-11.5 — реализовать независимый переключатель услуги </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="032220E5" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:t xml:space="preserve">Изучи существующие </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>feature</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>flags</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>, административные настройки и механизмы контроля доступности платных услуг. Используй подход, принятый в проекте.</w:t></w:r></w:p><w:p w14:paraId="4F54AB43" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> должен управляться отдельно от других услуг и обычных системных </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>-уведомлений.</w:t></w:r></w:p><w:p w14:paraId="7E3AFA69" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t>Реализуй следующие требования:</w:t></w:r></w:p><w:p w14:paraId="37A59385" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Добавь отдельный переключатель </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> в предусмотренный административный интерфейс.</w:t></w:r></w:p><w:p w14:paraId="66191514" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Разреши изменять его состояние только пользователям с соответствующими административными полномочиями.</w:t></w:r></w:p><w:p w14:paraId="6B4A9035" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Обеспечь сохранение настройки после перезагрузки интерфейса и перезапуска приложения в соответствии с архитектурой проекта.</w:t></w:r></w:p><w:p w14:paraId="268B2955" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>При выключенной услуге блокируй создание новых заказов, покупку и запуск новых рекламных рассылок на сервере.</w:t></w:r></w:p><w:p w14:paraId="43BD60E5" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Проверь защиту от прямых API-запросов, повторной отправки старого запроса и обхода через открытую ранее страницу.</w:t></w:r></w:p><w:p w14:paraId="533B01D0" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>При включении услуги снова разрешай новые операции после стандартных серверных проверок.</w:t></w:r></w:p><w:p w14:paraId="19C1737D" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Не допускай изменения поведения других рекламных услуг, обычных системных </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>-уведомлений и иных функций платформы.</w:t></w:r></w:p><w:p w14:paraId="2D783D9B" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Сохраняй историю заказов, оплат и завершённых кампаний.</w:t></w:r></w:p><w:p w14:paraId="78E029D0" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Обрабатывай оплаченные, но ещё не отправленные кампании согласно отдельно утверждённым правилам. Если таких правил нет, не придумывай автоматическую отмену, возврат или запуск.</w:t></w:r></w:p><w:p w14:paraId="4AB10DD8" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>Если предусмотрен аудит административных действий, записывай изменения переключателя.</w:t></w:r></w:p><w:p w14:paraId="056CE5EC" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:rPr><w:rStyle w:val="a4"/></w:rPr><w:t>Проведи обязательные проверки:</w:t></w:r></w:p><w:p w14:paraId="3DBD4907" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> выключен — покупка заблокирована.</w:t></w:r></w:p><w:p w14:paraId="21A77786" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> выключен — запуск прямым серверным запросом заблокирован.</w:t></w:r></w:p><w:p w14:paraId="30A10B53" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> включён — корректный заказ проходит стандартные проверки.</w:t></w:r></w:p><w:p w14:paraId="2D3C391C" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>Изменение состояния сохраняется.</w:t></w:r></w:p><w:p w14:paraId="7A67A55C" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>Пользователь без административных прав не может изменить переключатель.</w:t></w:r></w:p><w:p w14:paraId="753FB17B" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Отключение </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Target</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Push</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> не отключает другие уведомления.</w:t></w:r></w:p><w:p w14:paraId="2788ADA7" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>Включение после отключения не вызывает повторных платежей и не запускает старые кампании автоматически.</w:t></w:r></w:p><w:p w14:paraId="417A9DC9" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>Ограничение в одну отправку в день на категорию сохраняется при обоих состояниях переключателя.</w:t></w:r></w:p><w:p w14:paraId="1803F1C0" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:t>Не считай скрытие элементов интерфейса достаточной реализацией: блокировка обязательна на сервере.</w:t></w:r></w:p><w:p w14:paraId="6A5E2266" w14:textId="77777777" w:rsidR="00803296" w:rsidRDefault="00803296" w:rsidP="00803296"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:t>В отчёте укажи место переключателя, серверные проверки, требования к правам, результаты тестов и оставшиеся вопросы. Не выполняй финальный аудит. Остановись и дождись подтверждения.</w:t></w:r></w:p><w:p w14:paraId="35C41503" w14:textId="77777777" w:rsidR="00660E9A" w:rsidRDefault="00660E9A"/><w:sectPr w:rsidR="00660E9A"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1134" w:right="850" w:bottom="1134" w:left="1701" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>